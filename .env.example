# OpenAI-compatible provider (LM Studio defaults)
NEXUS_API_BASE_URL=http://127.0.0.1:1234/v1
NEXUS_API_KEY=
NEXUS_MODEL=google/gemma-4-e4b

# Generation
NEXUS_MAX_TOKENS=2048
NEXUS_TEMPERATURE=0.2
NEXUS_REQUEST_TIMEOUT=180

# Local Nexus gateway
NEXUS_BACKEND_HOST=127.0.0.1
NEXUS_BACKEND_PORT=8000

# Read every answer aloud (0 = off, 1 = on)
NEXUS_TTS_ENABLED=0
# auto = Supertonic when installed, otherwise Windows SAPI. edge is cloud opt-in.
NEXUS_TTS_BACKEND=auto
# Optional Windows SAPI voice ID and speaking rate
NEXUS_TTS_VOICE=
NEXUS_TTS_RATE=180
# Used only when NEXUS_TTS_BACKEND=edge
NEXUS_EDGE_TTS_VOICE=tr-TR-AhmetNeural
# Supertonic local neural voice tuning
NEXUS_TTS_LANGUAGE=tr
NEXUS_SUPERTONIC_SPEAKER=0
NEXUS_SUPERTONIC_SPEED=1.1
NEXUS_SUPERTONIC_STEPS=8
NEXUS_TTS_THREADS=2
